# Copy to .env.local (ignored by Git). Server-only values; never use browser storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NRGOPT_ADMIN_USER_ID=
NRGOPT_APP_ORIGIN=http://127.0.0.1:4317
# Enable only after migration in an isolated local/development project.
NRGOPT_INTELLIGENCE_WRITE_ENABLED=0
# Production additionally requires this separate release switch. Keep it 0 until production migration and smoke checks pass.
NRGOPT_INTELLIGENCE_PRODUCTION_WRITE_ENABLED=0
# Provider routing. MiniMax discovery uses the Coding Plan search API;
# analysis must support Chat Completions-compatible JSON output.
NRGOPT_DISCOVERY_PROVIDER=minimax
NRGOPT_DISCOVERY_ENDPOINT=https://api.minimaxi.com/v1/coding_plan/search
NRGOPT_DISCOVERY_MODEL=coding-plan-search
NRGOPT_DISCOVERY_CURRENCY=CNY
NRGOPT_DISCOVERY_BILLING_MODE=included
NRGOPT_DISCOVERY_API_KEY=
NRGOPT_ANALYSIS_PROVIDER=deepseek
NRGOPT_ANALYSIS_ENDPOINT=https://api.deepseek.com/chat/completions
NRGOPT_ANALYSIS_MODEL=deepseek-flash
NRGOPT_ANALYSIS_CURRENCY=CNY
NRGOPT_ANALYSIS_BILLING_MODE=balance
NRGOPT_ANALYSIS_API_KEY=
# 32 random bytes encoded as base64. Required only to save API keys from the private settings page.
NRGOPT_PROVIDER_CONFIG_KEY=
# Legacy key names remain supported for existing deployments.
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
# Monthly hard stops in millionths of the configured currency.
NRGOPT_DISCOVERY_MONTHLY_LIMIT_MICRO=
NRGOPT_ANALYSIS_MONTHLY_LIMIT_MICRO=
# Legacy reserve names remain supported.
NRGOPT_MINIMAX_DISCOVERY_RESERVE_MICROCNY=
NRGOPT_DEEPSEEK_EXTRACTION_RESERVE_MICROCNY=
# Scheduler stays disabled until a server-only secret and this explicit switch are configured.
CRON_SECRET=
NRGOPT_SCHEDULER_ENABLED=0
# Mac archive pull stays disabled until a server token, node name and local path are configured.
NRGOPT_ARCHIVE_TOKEN=
NRGOPT_ARCHIVE_ENABLED=0
NRGOPT_ARCHIVE_NODE_ID=mac-mini
NRGOPT_ARCHIVE_BASE_URL=http://127.0.0.1:4317
NRGOPT_ARCHIVE_DIR=
# Feishu delivery remains off until an authorized group webhook is stored server-side.
FEISHU_WEBHOOK_URL=
NRGOPT_FEISHU_ENABLED=0
