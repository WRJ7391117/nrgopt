# Copy to .env.local (ignored by Git). Server-only values; never use browser storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NRGOPT_ADMIN_USER_ID=
NRGOPT_APP_ORIGIN=http://127.0.0.1:4317
# Enable only after migration in an isolated local/development project.
NRGOPT_INTELLIGENCE_WRITE_ENABLED=0
# Production additionally requires this separate release switch. Keep it 0 until production migration and smoke checks pass.
NRGOPT_INTELLIGENCE_PRODUCTION_WRITE_ENABLED=0
# Server-only. Required only when the authorized user runs Chinese extraction.
DEEPSEEK_API_KEY=
# Server-only. Used only for MiniMax web search source discovery.
MINIMAX_API_KEY=
# Hard-stop estimates in millionths of CNY for Chinese providers. USD variables are reserved for future US providers.
NRGOPT_MINIMAX_DISCOVERY_RESERVE_MICROCNY=
NRGOPT_DEEPSEEK_EXTRACTION_RESERVE_MICROCNY=
NRGOPT_DEEPSEEK_CROSS_CHECK_RESERVE_MICROCNY=
# Scheduler stays disabled until a server-only secret and this explicit switch are configured.
CRON_SECRET=
NRGOPT_SCHEDULER_ENABLED=0
# Mac archive pull stays disabled until a server token, node name and local path are configured.
NRGOPT_ARCHIVE_TOKEN=
NRGOPT_ARCHIVE_ENABLED=0
NRGOPT_ARCHIVE_NODE_ID=mac-mini
NRGOPT_ARCHIVE_BASE_URL=http://127.0.0.1:4317
NRGOPT_ARCHIVE_DIR=
# Feishu delivery remains off until an authorized group webhook is stored server-side.
FEISHU_WEBHOOK_URL=
NRGOPT_FEISHU_ENABLED=0
